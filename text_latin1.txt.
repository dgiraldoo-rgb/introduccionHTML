<!doctype html><html lang="ca"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>NOVA · Acollida preventiva interactiva</title><style>
:root{--navy:#10263c;--blue:#205b98;--teal:#087f78;--bg:#f3f6fa;--ink:#182b3d;--muted:#586a7b;--line:#d9e3ec;--good:#176f4a;--bad:#9a3e32}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 system-ui,-apple-system,Segoe UI,sans-serif}header{background:var(--navy);color:white;padding:18px max(20px,calc((100vw - 1000px)/2));display:flex;align-items:center;justify-content:space-between;gap:12px}.logo{font-weight:850;letter-spacing:2px;font-size:25px}.tag{font-size:12px;opacity:.78}main{max-width:1000px;margin:24px auto;padding:0 18px 70px}.panel{background:white;border:1px solid var(--line);border-radius:17px;padding:clamp(20px,4vw,38px);box-shadow:0 7px 25px #1b35520a}.eyebrow{color:var(--teal);font-weight:800;letter-spacing:1.5px;font-size:12px;text-transform:uppercase}h1{font-size:clamp(27px,4vw,39px);line-height:1.15;margin:10px 0 18px}h2{font-size:24px;line-height:1.25;margin:8px 0 14px}h3{font-size:18px;margin:20px 0 8px}p{margin:10px 0 14px}.muted{color:var(--muted)}.lead{font-size:18px}.btn{appearance:none;border:0;background:var(--blue);color:white;padding:13px 19px;border-radius:10px;font-weight:750;font-size:15px;cursor:pointer}.btn:hover{filter:brightness(.94)}.btn:disabled{opacity:.42;cursor:not-allowed}.btn.alt{background:#e7eff7;color:var(--navy)}.btn.outline{border:1px solid var(--line);background:white;color:var(--navy)}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:25px}.progress{height:9px;background:#e5edf4;border-radius:50px;overflow:hidden;margin:15px 0}.progress>div{height:100%;background:var(--teal);transition:width .2s}.bartext{display:flex;justify-content:space-between;color:var(--muted);font-size:13px;gap:12px}.choices{display:grid;gap:11px;margin:19px 0}.choice{border:1.5px solid #d8e2ec;background:#fff;text-align:left;padding:14px 16px;border-radius:11px;font:inherit;cursor:pointer;display:flex;gap:12px}.choice .letter{flex:0 0 28px;height:28px;border-radius:50%;background:#e8eff6;display:grid;place-items:center;font-size:13px;font-weight:800}.choice:hover{border-color:#5b93c0;background:#f8fbff}.choice.selected{border-color:var(--blue);background:#edf5fc}.choice.correct{border-color:var(--good);background:#e9f7ef}.choice.incorrect{border-color:var(--bad);background:#fff0ed}.choice:disabled{cursor:default}.feedback{border-left:4px solid var(--teal);background:#eff8f6;padding:15px 18px;border-radius:0 10px 10px 0;margin-top:16px}.feedback.error{border-color:var(--bad);background:#fff3ef}.learning{background:#f1f6fa;border-radius:13px;padding:18px 21px;margin:18px 0}.learning strong{color:var(--navy)}.scene{margin:22px 0;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:#eaf0f5}.scene svg{width:100%;height:auto;display:block}.scene figcaption{padding:9px 14px;font-size:12px;color:var(--muted);background:white}.chips{display:flex;gap:8px;flex-wrap:wrap;margin:15px 0}.chip{background:#eaf1f7;color:#244963;border-radius:50px;padding:5px 10px;font-size:12px;font-weight:750}.field{display:block;width:100%;max-width:420px;border:1.5px solid var(--line);border-radius:9px;padding:12px;font:inherit}.result{display:flex;gap:20px;align-items:center;flex-wrap:wrap;background:#eef7f6;padding:20px;border-radius:13px}.score{font-size:44px;font-weight:850;color:var(--teal)}.small{font-size:13px}.review{border-top:1px solid var(--line);padding:14px 0}.review strong{display:block}.review .wrong{color:var(--bad)}.review .right{color:var(--good)}.notice{background:#fff8e8;border-left:4px solid #c89226;padding:12px 16px;border-radius:0 9px 9px 0}.hidden{display:none}@media print{header,.actions,.bartext,.progress,.noprint{display:none!important}body{background:white}main{margin:0;max-width:none}.panel{box-shadow:none;border:none}.review{break-inside:avoid}}
</style></head><body><header><div><div class="logo">NOVA<span style="color:#79d3c7">.</span></div><div class="tag">Formació interna · Acollida de personal</div></div><div class="tag">Simulació educativa · IPO I</div></header><main><div id="app" class="panel"></div></main><script>
